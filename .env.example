# Copy this file to .env and fill in values.

# One of: openai | gemini
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-yourkey

# Google Gemini
GOOGLE_API_KEY=your-gemini-key

# Set to 'chroma' or 'faiss'
VECTOR_STORE=chroma

# SQLite file path (your provided DB should live in ./data/)
DATABASE_PATH=./data/1751978414.sqlite3

# Retrieval / performance knobs
RETRIEVAL_TOP_K=4
RESULT_ROW_LIMIT=50
